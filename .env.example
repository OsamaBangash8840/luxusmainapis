# MongoDB connection string
MONGO_URI=mongodb+srv://username:password@cluster0.mongodb.net/realestate

# JWT secret key for authentication
TOKEN_SECRET=your_jwt_secret_here

# JWT secret key for email verification (optional, falls back to TOKEN_SECRET)
VERIFICATION_SECRET=your_verification_secret_here

# The URL of the frontend application
FRONTEND_URL=https://luxusrealestate-next-ts.vercel.app

# The URL of the backend application
BACKEND_URL=https://3-27-86-15.sslip.io

# Optional CORS origins (comma separated)
CORS_ORIGINS=https://luxusrealestate-next-ts.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# Port for the server to listen on
PORT=8000

# Email address for sending system emails
EMAIL=noreply@example.com

# App password for the email account
APP_PASSWORD=your_email_app_password

# Google OAuth Client ID
GOOGLE_CLIENT_ID=your_google_client_id

# Google OAuth Client Secret
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Google OAuth Callback URL & Signup Secret
GOOGLE_CALLBACK_URL=https://3-27-86-15.sslip.io/api/auth/google/callback
GOOGLE_SIGNUP_SECRET=your_google_signup_secret

# Stripe Secret Key for payments
STRIPE_SECRET_KEY=your_stripe_secret_key

# Stripe Webhook Secret for receiving payment events
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Cloudinary Cloud Name for image uploads
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Cloudinary API Key
CLOUDINARY_API_KEY=your_cloudinary_api_key

# Cloudinary API Secret
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Node Environment (development or production)
NODE_ENV=development
